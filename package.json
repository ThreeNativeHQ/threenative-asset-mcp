{
  "name": "threenative-asset-mcp",
  "version": "0.9.5",
  "description": "MCP server for discovering and safely downloading 3D and game-audio assets from curated public sources.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "threenative-asset-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "vendor/anycreature-1.3.1.zip",
    "scripts/audio-semantic.py",
    "README.md"
  ],
  "keywords": [
    "fab",
    "polyhaven",
    "ambientcg",
    "smithsonian",
    "sketchfab",
    "audio-assets",
    "game-audio",
    "3d-assets",
    "mcp",
    "model-context-protocol",
    "threenative"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative-asset-mcp.git"
  },
  "homepage": "https://github.com/ThreeNativeHQ/threenative-asset-mcp#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative-asset-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "browser:install": "playwright install chromium",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "doctor": "tsx scripts/doctor.ts",
    "probe:fab": "tsx scripts/probe-fab.ts",
    "parity:fab": "tsx scripts/fab-parity.ts",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1 --exclude tests/mcp-smoke.test.ts --reporter=default --reporter=junit --outputFile=artifacts/ci/tests.xml",
    "test:smoke": "vitest run tests/mcp-smoke.test.ts --maxWorkers=1 --reporter=default --reporter=junit --outputFile=artifacts/ci/mcp-smoke.xml",
    "test:leaks": "tsx scripts/leak-gate.ts -- vitest run",
    "test:live": "tsx scripts/probe-fab.ts",
    "test:providers:live": "npm run build && tsx scripts/probe-providers.ts",
    "provision:toolchain": "tsx scripts/provision-toolchain.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx --yes @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@modelcontextprotocol/server": "2.0.0",
    "@threenative/playtest": "0.3.2",
    "@zip.js/zip.js": "2.8.34",
    "playwright": "1.62.0",
    "sharp": "0.35.4",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/three": "0.185.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
